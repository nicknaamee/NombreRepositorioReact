{
  "name": "nombre-repositorio-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:inventory": "node scripts/check-test-count.mjs",
    "test:build": "node scripts/build-tests.mjs",
    "test": "npm run test:inventory && npm run test:build && karma start karma.conf.cjs",
    "test:browser": "npm run test:build && karma start karma.conf.cjs --browsers Chrome --single-run=false",
    "test:dom": "npm run test:inventory && npm run test:build && karma start karma.conf.cjs --browsers jsdom --hostname 127.0.0.1"
  },
  "dependencies": {
    "bulma": "1.0.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "esbuild": "0.25.12",
    "jasmine-core": "5.12.1",
    "jsdom": "26.1.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jsdom-launcher": "22.0.0",
    "vite": "6.4.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
